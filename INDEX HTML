<!DOCTYPE html>
<html lang="id" translate="no" class="notranslate">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="google" content="notranslate">
    <title>CBT Anti-Cheat | STS Matematika Kelas VIII</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        /* Anti-Seleksi Teks & Anti-Callout Mobile */
        html, body {
            font-family: 'Inter', system-ui, sans-serif;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
            -webkit-touch-callout: none;
            overscroll-behavior: none;
        }

        /* Izinkan seleksi hanya pada input login */
        input, select {
            -webkit-user-select: text;
            user-select: text;
        }

        /* Custom Scrollbar Rapi untuk Area Soal */
        .custom-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scroll::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        .custom-scroll::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        .custom-scroll::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* Mirror video kamera depan agar natural */
        .mirror-video {
            transform: scaleX(-1);
        }

        /* Floating Camera touch handling */
        #floating-camera {
            touch-action: none;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased min-h-screen notranslate" translate="no">

    <!-- ===================================================================== -->
    <!-- 1. HALAMAN LOGIN                                                      -->
    <!-- ===================================================================== -->
    <section id="view-login" class="min-h-screen flex items-center justify-center p-4 bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900">
        <div class="w-full max-w-md bg-white rounded-2xl shadow-2xl overflow-hidden border border-slate-200/60">
            <!-- Header Card -->
            <div class="bg-indigo-600 px-6 py-6 text-center text-white">
                <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-white/15 backdrop-blur-sm mb-3 shadow-inner">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                </div>
                <span class="block text-xs font-semibold tracking-widest uppercase text-indigo-200">CBT Anti-Cheat System</span>
                <h1 class="text-xl sm:text-2xl font-extrabold mt-1">Sumatif Tengah Semester</h1>
                <p class="text-sm text-indigo-100 mt-0.5">Mata Pelajaran: Matematika • Kelas VIII</p>
            </div>

            <!-- Form Login -->
            <form id="form-login" class="p-6 space-y-4" novalidate>
                <!-- Pesan Error Inline -->
                <div id="login-error" class="hidden p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-sm flex items-start gap-2">
                    <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span id="login-error-text">Mohon lengkapi semua data.</span>
                </div>

                <div>
                    <label for="input-nama" class="block text-sm font-semibold text-slate-700 mb-1.5">Nama Lengkap <span class="text-rose-500">*</span></label>
                    <input type="text" id="input-nama" required autocomplete="off" placeholder="Masukkan nama lengkap Anda"
                        class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition text-sm">
                </div>

                <div>
                    <label for="input-kelas" class="block text-sm font-semibold text-slate-700 mb-1.5">Kelas <span class="text-rose-500">*</span></label>
                    <select id="input-kelas" required
                        class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition text-sm">
                        <option value="" disabled selected>-- Pilih Kelas --</option>
                        <option value="8 A">Kelas 8 A</option>
                        <option value="8 B">Kelas 8 B</option>
                        <option value="8 C">Kelas 8 C</option>
                    </select>
                </div>

                <div>
                    <label for="input-token" class="block text-sm font-semibold text-slate-700 mb-1.5">Token Ujian <span class="text-rose-500">*</span></label>
                    <input type="password" id="input-token" required autocomplete="off" inputmode="numeric" placeholder="Masukkan token ujian"
                        class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition text-sm tracking-widest font-mono">
                    <p class="text-xs text-slate-400 mt-1">Masukkan token yang diberikan oleh pengawas ujian.</p>
                </div>

                <button type="submit"
                    class="w-full py-3.5 px-4 bg-indigo-600 hover:bg-indigo-700 active:scale-[0.99] text-white font-bold rounded-xl shadow-lg shadow-indigo-600/25 transition flex items-center justify-center gap-2">
                    <span>Lanjut ke Pemeriksaan Perangkat</span>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                    </svg>
                </button>
            </form>

            <div class="bg-slate-50 px-6 py-3 border-t border-slate-100 text-center text-xs text-slate-500">
                Tahun Pelajaran 2026/2027 • Waktu: 90 Menit • 40 Soal PG
            </div>
        </div>
    </section>

    <!-- ===================================================================== -->
    <!-- 2. HALAMAN PERSIAPAN (DEVICE CHECK)                                   -->
    <!-- ===================================================================== -->
    <section id="view-prep" class="hidden min-h-screen flex items-center justify-center p-4 bg-slate-100">
        <div class="w-full max-w-2xl bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
            <div class="bg-slate-900 text-white px-6 py-4 flex items-center justify-between">
                <div>
                    <h2 class="text-lg font-bold">Pemeriksaan Perangkat & Pengawasan</h2>
                    <p class="text-xs text-slate-300 mt-0.5">Peserta: <span id="prep-nama" class="font-semibold text-white"></span> (<span id="prep-kelas"></span>)</p>
                </div>
                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/20 text-indigo-200 border border-indigo-400/30">Langkah 2/2</span>
            </div>

            <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Preview Kamera -->
                <div class="flex flex-col">
                    <div class="relative aspect-video md:aspect-[4/3] bg-slate-900 rounded-xl overflow-hidden border-2 border-slate-200 flex items-center justify-center">
                        <video id="prep-video" autoplay playsinline muted class="w-full h-full object-cover mirror-video hidden"></video>
                        <div id="prep-video-placeholder" class="text-center p-4 text-slate-400">
                            <svg class="w-12 h-12 mx-auto mb-2 opacity-60" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                            </svg>
                            <p class="text-xs font-medium">Menunggu izin Kamera & Mikrofon...</p>
                        </div>
                        <div id="prep-cam-badge" class="hidden absolute top-2.5 left-2.5 px-2.5 py-1 rounded-full bg-emerald-600/90 text-white text-[11px] font-semibold flex items-center gap-1.5 shadow">
                            <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
                            Kamera & Mic Aktif
                        </div>
                    </div>

                    <!-- Status Permission Box -->
                    <div id="prep-status-box" class="mt-3 p-3 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-xs">
                        Klik tombol di bawah untuk mengizinkan akses <strong>Kamera</strong> dan <strong>Mikrofon</strong>. Ujian tidak dapat dimulai tanpa izin perangkat.
                    </div>

                    <button id="btn-request-media" type="button"
                        class="mt-3 w-full py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-900 text-white text-sm font-semibold transition flex items-center justify-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        <span>Izinkan Kamera & Mikrofon</span>
                    </button>
                </div>

                <!-- Tata Tertib Anti-Curang -->
                <div class="flex flex-col justify-between">
                    <div>
                        <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider mb-3">Tata Tertib Ujian</h3>
                        <ul class="space-y-2.5 text-xs sm:text-sm text-slate-600">
                            <li class="flex items-start gap-2.5">
                                <span class="w-5 h-5 rounded-full bg-indigo-100 text-indigo-700 font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">1</span>
                                <span>Waktu pengerjaan <strong>90 menit</strong> untuk <strong>40 soal</strong> pilihan ganda.</span>
                            </li>
                            <li class="flex items-start gap-2.5">
                                <span class="w-5 h-5 rounded-full bg-indigo-100 text-indigo-700 font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">2</span>
                                <span>Layar akan masuk ke mode <strong>Fullscreen</strong> secara otomatis saat ujian dimulai.</span>
                            </li>
                            <li class="flex items-start gap-2.5">
                                <span class="w-5 h-5 rounded-full bg-rose-100 text-rose-700 font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">3</span>
                                <span>Dilarang pindah tab, keluar layar, split screen, atau menekan tombol shortcut. <strong>Alarm sirine akan berbunyi!</strong></span>
                            </li>
                            <li class="flex items-start gap-2.5">
                                <span class="w-5 h-5 rounded-full bg-rose-100 text-rose-700 font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">4</span>
                                <span>Batas maksimal <strong>3 kali peringatan</strong>. Pelanggaran ke-3 akan langsung menghentikan ujian (<strong>Diskualifikasi</strong>).</span>
                            </li>
                        </ul>
                    </div>

                    <div class="mt-6 pt-4 border-t border-slate-100 flex flex-col gap-2">
                        <button id="btn-start-exam" type="button" disabled
                            class="w-full py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 disabled:bg-slate-300 disabled:text-slate-500 disabled:cursor-not-allowed text-white font-bold shadow-lg shadow-emerald-600/20 disabled:shadow-none transition flex items-center justify-center gap-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <span>Mulai Ujian</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===================================================================== -->
    <!-- 3. HALAMAN UJIAN (MOBILE-FRIENDLY DENGAN STICKY HEADER & FOOTER)      -->
    <!-- ===================================================================== -->
    <section id="view-exam" class="hidden h-[100dvh] flex flex-col bg-slate-100 overflow-hidden">
        <!-- STICKY HEADER -->
        <header class="bg-white border-b border-slate-200 px-3 sm:px-5 py-2.5 shrink-0 shadow-sm z-20">
            <div class="max-w-4xl mx-auto flex items-center justify-between gap-2">
                <!-- Info Mapel & Peserta -->
                <div class="min-w-0">
                    <h1 class="text-xs sm:text-sm font-extrabold text-indigo-700 truncate">STS MATEMATIKA VIII</h1>
                    <p class="text-[11px] sm:text-xs text-slate-500 truncate">
                        <span id="exam-header-nama" class="font-semibold text-slate-700"></span> • <span id="exam-header-kelas"></span>
                    </p>
                </div>

                <!-- Timer & Tombol Daftar Soal -->
                <div class="flex items-center gap-1.5 sm:gap-2.5 shrink-0">
                    <!-- Timer 90 Menit -->
                    <div id="timer-badge" class="flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-xl bg-slate-900 text-white font-mono text-xs sm:text-sm font-bold shadow-sm">
                        <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span id="timer-display">90:00</span>
                    </div>

                    <!-- Tombol Popup Daftar Soal -->
                    <button id="btn-open-nav" type="button"
                        class="flex items-center gap-1.5 px-2.5 sm:px-3.5 py-1.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 active:bg-indigo-200 text-indigo-700 border border-indigo-200 font-semibold text-xs sm:text-sm transition">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                        </svg>
                        <span class="hidden sm:inline">Daftar Soal</span>
                        <span id="nav-btn-count" class="px-1.5 py-0.5 rounded-md bg-indigo-600 text-white text-[10px] font-bold">0/40</span>
                    </button>
                </div>
            </div>
        </header>

        <!-- BAR INDIKATOR STATUS (TERJAWAB, BELUM, SISA PERINGATAN) -->
        <div class="bg-slate-50 border-b border-slate-200 px-3 sm:px-5 py-1.5 shrink-0 z-10">
            <div class="max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-2 text-[11px] sm:text-xs font-medium">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center gap-1.5 text-emerald-700">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                        Terjawab: <strong id="stat-answered">0</strong>
                    </span>
                    <span class="inline-flex items-center gap-1.5 text-slate-600">
                        <span class="w-2.5 h-2.5 rounded-full bg-slate-300 border border-slate-400"></span>
                        Belum: <strong id="stat-unanswered">40</strong>
                    </span>
                </div>
                <div id="warning-indicator" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-semibold">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span>Sisa Peringatan: <strong id="stat-warnings-left">3</strong>/3</span>
                </div>
            </div>
            <!-- Progress Bar Pengerjaan -->
            <div class="max-w-4xl mx-auto mt-1.5 h-1.5 w-full bg-slate-200 rounded-full overflow-hidden">
                <div id="exam-progress-bar" class="h-full bg-emerald-500 transition-all duration-300 rounded-full" style="width: 0%"></div>
            </div>
        </div>

        <!-- AREA KONTEN SOAL (SCROLLABLE TERPISAH DARI FOOTER) -->
        <main id="question-scroll-area" class="flex-1 overflow-y-auto custom-scroll px-3 sm:px-5 py-4 sm:py-6">
            <div class="max-w-4xl mx-auto pb-24">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-4 sm:p-7">
                    <!-- Nomor Soal & Kategori Materi -->
                    <div class="flex flex-wrap items-center justify-between gap-2 pb-3 mb-4 border-b border-slate-100">
                        <div class="flex items-center gap-2">
                            <span id="q-number-badge" class="px-3 py-1 rounded-lg bg-blue-600 text-white text-xs sm:text-sm font-bold shadow-sm">
                                Soal No. 1
                            </span>
                            <span id="q-topic-badge" class="px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 text-[11px] sm:text-xs font-semibold">
                                A. RELASI DAN FUNGSI
                            </span>
                        </div>
                        <span id="q-status-pill" class="text-xs font-medium text-slate-400">Belum dijawab</span>
                    </div>

                    <!-- Teks Soal -->
                    <div id="q-text" class="text-base sm:text-lg text-slate-800 font-medium leading-relaxed mb-6 select-none">
                        Memuat soal...
                    </div>

                    <!-- Pilihan Jawaban A, B, C, D -->
                    <div id="q-options" class="space-y-3">
                        <!-- Diisi oleh JavaScript -->
                    </div>
                </div>
            </div>
        </main>

        <!-- STICKY FOOTER NAVIGASI -->
        <footer class="bg-white border-t border-slate-200 px-3 sm:px-5 py-3 shrink-0 shadow-[0_-4px_12px_rgba(0,0,0,0.04)] z-20">
            <div class="max-w-4xl mx-auto flex items-center justify-between gap-2 sm:gap-3">
                <button id="btn-prev" type="button"
                    class="flex-1 sm:flex-none sm:min-w-[130px] py-2.5 px-3 sm:px-4 rounded-xl bg-slate-100 hover:bg-slate-200 disabled:opacity-40 disabled:cursor-not-allowed text-slate-700 font-semibold text-xs sm:text-sm transition flex items-center justify-center gap-1.5">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                    </svg>
                    <span>Sebelumnya</span>
                </button>

                <button id="btn-finish-trigger" type="button"
                    class="py-2.5 px-3.5 sm:px-5 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] text-white font-bold text-xs sm:text-sm shadow-md shadow-emerald-600/20 transition flex items-center justify-center gap-1.5">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span>Selesai</span>
                </button>

                <button id="btn-next" type="button"
                    class="flex-1 sm:flex-none sm:min-w-[130px] py-2.5 px-3 sm:px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 disabled:opacity-40 disabled:cursor-not-allowed text-white font-semibold text-xs sm:text-sm shadow-md shadow-indigo-600/20 transition flex items-center justify-center gap-1.5">
                    <span>Selanjutnya</span>
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                    </svg>
                </button>
            </div>
        </footer>
    </section>

    <!-- FLOATING CAMERA (DRAGGABLE MOUSE & TOUCH DENGAN BATASAN LAYAR) -->
    <div id="floating-camera" class="hidden fixed bottom-20 right-3 w-28 h-36 sm:w-36 sm:h-44 rounded-2xl overflow-hidden shadow-2xl border-2 border-indigo-500 bg-slate-900 z-30 cursor-grab active:cursor-grabbing select-none">
        <video id="exam-video" autoplay playsinline muted class="w-full h-full object-cover mirror-video pointer-events-none"></video>
        <div class="absolute top-1.5 left-1.5 px-1.5 py-0.5 rounded-md bg-black/60 backdrop-blur-sm text-[9px] font-bold text-white flex items-center gap-1 pointer-events-none">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
            LIVE
        </div>
        <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/75 to-transparent py-1 text-center text-[9px] text-white/90 font-medium pointer-events-none">
            Geser Kamera
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- 4. HALAMAN HASIL & PENGIRIMAN GOOGLE SHEETS                           -->
    <!-- ===================================================================== -->
    <section id="view-result" class="hidden min-h-screen flex items-center justify-center p-4 bg-slate-100">
        <div class="w-full max-w-lg bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
            <div id="result-header" class="bg-indigo-600 px-6 py-6 text-center text-white">
                <div id="result-icon" class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-white/20 mb-3">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <h2 class="text-xl font-extrabold">Ujian Telah Berakhir</h2>
                <p id="result-status-badge" class="inline-block mt-2 px-3 py-1 rounded-full bg-white/20 text-xs font-bold tracking-wide uppercase">
                    Status: Selesai
                </p>
            </div>

