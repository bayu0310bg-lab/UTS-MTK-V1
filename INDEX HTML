        function triggerCheatViolation(reason) {
            // Debounce agar event blur & visibilitychange bersamaan tidak dihitung 2x
            const now = Date.now();
            if (now - state.lastViolationTime < CHEAT_DEBOUNCE_MS) {
                // Tetap pastikan sirine berbunyi jika masih di luar layar
                if (document.hidden || !document.hasFocus()) {
                    startSiren();
                }
                return;
            }
            state.lastViolationTime = now;
            state.violationCount += 1;

            updateWarningIndicator();

            if (state.violationCount >= MAX_VIOLATIONS) {
                // Pelanggaran ke-3 -> Auto-Submit dengan status Diskualifikasi (Curang)
                stopSiren();
                document.getElementById("modal-cheat-warning").classList.add("hidden");
                finishExam("Diskualifikasi (Curang)");
                return;
            }

            // Bunyikan alarm sirine Web Audio API & tampilkan modal peringatan
            startSiren();
            document.getElementById("cheat-count-text").textContent = state.violationCount;
            document.getElementById("modal-cheat-warning").classList.remove("hidden");
